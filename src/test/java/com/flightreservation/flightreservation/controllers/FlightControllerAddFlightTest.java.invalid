package com.flightreservation.flightreservation.controllers;import com.flightreservation.flightreservation.domains.Flight;
import com.flightreservation.flightreservation.repositories.FlightRepository;
import org.junit.Before;
import org.junit.Test;
import org.junit.experimental.categories.Category;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.MockitoAnnotations;
import org.springframework.ui.ModelMap;
import static org.mockito.Mockito.*;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.format.annotation.DateTimeFormat;
import org.springframework.stereotype.Controller;
import org.springframework.web.bind.annotation.ModelAttribute;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RequestParam;
import java.util.Date;
import java.util.List;

public class FlightControllerAddFlightTest {
    @Mock
    private FlightRepository flightRepository;
    @InjectMocks
    private FlightController flightController;
    @Before
    public void setUp() {
        MockitoAnnotations.initMocks(this);
    }
    @Test
    @Category(Categories.valid.class)
    public void testSuccessfulFlightAddition() {
        Flight flight = new Flight();
        ModelMap modelMap = new ModelMap();
        String result = flightController.addFlight(flight, modelMap);
        verify(flightRepository, times(1)).save(flight);
        assertEquals("Flight Added Successfully", (String)modelMap.get("msg"));
        assertEquals("flights/addFlight", result);
    }
    @Test
    @Category(Categories.valid.class)
    public void testAddFlightWithNullFields() {
        Flight flight = new Flight();
        flight.setDepartureCity(null);
        flight.setArrivalCity(null);
        ModelMap modelMap = new ModelMap();
        String result = flightController.addFlight(flight, modelMap);
        verify(flightRepository, times(1)).save(flight);
        assertEquals("Flight Added Successfully", (String)modelMap.get("msg"));
        assertEquals("flights/addFlight", result);
    }
    @Test
    @Category(Categories.invalid.class)
    public void testAddFlightWithInvalidData() {
        // TODO: Define what constitutes invalid data for a Flight object
        Flight flight = new Flight();
        flight.setDateOfDeparture(new Date(-1)); // Assuming negative time is invalid
        ModelMap modelMap = new ModelMap();
        String result = flightController.addFlight(flight, modelMap);
        verify(flightRepository, never()).save(flight);
        assertNull(modelMap.get("msg")); // Assuming no message is set for invalid data
        assertEquals("flights/addFlight", result);
    }
    @Test
    @Category(Categories.invalid.class)
    public void testAddDuplicateFlight() {
        Flight existingFlight = new Flight();
        when(flightRepository.findByFlightDetails(existingFlight)).thenReturn(existingFlight);
        ModelMap modelMap = new ModelMap();
        String result = flightController.addFlight(existingFlight, modelMap);
        verify(flightRepository, never()).save(existingFlight);
        assertNull(modelMap.get("msg")); // Assuming no message is set for duplicate flight
        assertEquals("flights/addFlight", result);
    }
    @Test
    @Category(Categories.integration.class)
    public void testAddFlightWithException() {
        Flight flight = new Flight();
        ModelMap modelMap = new ModelMap();
        doThrow(new RuntimeException("Database error")).when(flightRepository).save(flight);
        String result = flightController.addFlight(flight, modelMap);
        verify(flightRepository, times(1)).save(flight);
        assertNull(modelMap.get("msg")); // Assuming no message is set for exception
        assertEquals("flights/addFlight", result);
    }
}