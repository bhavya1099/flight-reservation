public class UserControllerShowLoginPageTest {
    @Mock
    private UserRepository userRepository;
    @Mock
    private SecurityService securityService;
    @Mock
    private BCryptPasswordEncoder bCryptPasswordEncoder;
    @InjectMocks
    private UserController userController;
    @Before
    public void setUp() {
        MockitoAnnotations.initMocks(this);
    }
    @Test
    @Category(Categories.valid.class)
    public void showLoginPageReturnsCorrectViewName() {
        String viewName = userController.showLoginPage();
        assertEquals("login/login", viewName);
    }
    @Test
    @Category(Categories.valid.class)
    public void showLoginPageLogsCorrectMessage() {
        // Mock the logger
        Logger mockLogger = mock(Logger.class);
        when(mockLogger.isInfoEnabled()).thenReturn(true);
        doCallRealMethod().when(mockLogger).info(anyString());
        // Set the mock logger in the userController
        userController.LOGGER = mockLogger;
        // Call the method to be tested
        userController.showLoginPage();
        // Verify the logger was called with the correct message
        verify(mockLogger, times(1)).info("Inside showLoginPage()");
    }
    @Test
    @Category(Categories.valid.class)
    public void showLoginPageDoesNotThrowExceptions() {
        try {
            userController.showLoginPage();
        } catch (Exception e) {
            fail("showLoginPage() should not throw any exceptions");
        }
    }
    @Test
    @Category(Categories.valid.class)
    public void showLoginPageReturnsString() {
        String viewName = userController.showLoginPage();
